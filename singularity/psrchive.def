Bootstrap: localimage
From: psrbase.sif

%labels
    org.opencontainers.image.title psrchive
    org.opencontainers.image.source https://github.com/golamshaifullah/psrall_containers
    org.opencontainers.image.description "Source-built PSRCHIVE on packaged PGPLOT/HDF5 and current CFITSIO"

%environment
    export INSTALL_DIR=/usr/local
    export PSRCHIVE=/usr/local
    export PSRCHIVE_PATH=/usr/local

    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=/usr/include
    export PGPLOT_LIB=/usr/lib
    export PGPLOT_TYPE=pgplot

    export HDF5_DIR=/usr
    export HDF5_INCLUDE_DIR=/usr/include/hdf5/serial
    export HDF5_LIB_DIR=/usr/lib/x86_64-linux-gnu/hdf5/serial
    export HDF5_CFLAGS="-I/usr/include/hdf5/serial"
    export HDF5_LIBS="-L/usr/lib/x86_64-linux-gnu/hdf5/serial -lhdf5 -lhdf5_hl"

    export TEMPO2=/usr/local/tempo2
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins

    export PATH=/usr/local/bin:/usr/local/tempo2/bin:/opt/mamba/bin:$PATH
    export CPATH=/usr/local/include:/usr/include:/usr/include/hdf5/serial:/usr/include/eigen3:$CPATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:$LD_LIBRARY_PATH
    export LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:$LIBRARY_PATH
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:$PKG_CONFIG_PATH

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    export INSTALL_DIR=/usr/local
    export PSRCHIVE=/usr/local
    export PSRCHIVE_PATH=/usr/local
    export TEMPO2=/usr/local/tempo2
    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_INCLUDES=/usr/include
    export PGPLOT_LIB=/usr/lib
    export HDF5_INCLUDE_DIR=/usr/include/hdf5/serial
    export HDF5_LIB_DIR=/usr/lib/x86_64-linux-gnu/hdf5/serial
    export PATH=/usr/local/bin:/usr/local/tempo2/bin:/opt/mamba/bin:${PATH}
    export CPATH=/usr/local/include:/usr/include:/usr/include/hdf5/serial:/usr/include/eigen3:${CPATH:-}
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:${LD_LIBRARY_PATH:-}
    export LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:${LIBRARY_PATH:-}
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH:-}
    export NP=${NP:-$(nproc)}

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        gfortran \
        automake \
        autoconf \
        libtool \
        autoconf-archive \
        pkg-config \
        swig \
        python3 \
        python3-dev \
        python3-numpy \
        libxml2-dev \
        libfftw3-dev \
        libgsl-dev \
        libeigen3-dev \
        libblas-dev \
        liblapack-dev

    cd /tmp
    rm -rf psrchive
    git clone --depth=1 https://git.code.sf.net/p/psrchive/code psrchive
    cd psrchive

    export PYTHON=/usr/bin/python3
    export CPPFLAGS="-I/usr/local/include -I/usr/include -I/usr/include/hdf5/serial -I/usr/include/eigen3 ${CPPFLAGS:-}"
    export CFLAGS="${CPPFLAGS} ${CFLAGS:-}"
    export CXXFLAGS="${CPPFLAGS} ${CXXFLAGS:-}"
    export LDFLAGS="-L/usr/local/lib -L/usr/lib -L/usr/lib/x86_64-linux-gnu -L/usr/lib/x86_64-linux-gnu/hdf5/serial -Wl,-rpath,/usr/local/lib -Wl,-rpath,/usr/lib/x86_64-linux-gnu/hdf5/serial ${LDFLAGS:-}"

    ./bootstrap
    ./configure \
        PYTHON=/usr/bin/python3 \
        --prefix=${INSTALL_DIR} \
        --enable-shared \
        --with-x \
        --with-pgplot=/usr \
        --with-cfitsio-dir=/usr/local \
        --with-hdf5-dir=/usr \
        --with-eigen-include-dir=/usr/include/eigen3

    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make -j${NP}
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make install
    ldconfig

    rm -rf /tmp/psrchive
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

%test
    set -eu
    test -x /usr/local/bin/paz || test -x /usr/local/bin/pav || test -x /usr/local/bin/psrstat
    test -e /usr/local/lib/libpsrchive.so || test -e /usr/local/lib/libpsrchive.a
