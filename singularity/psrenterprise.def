Bootstrap: localimage
From: psrbase.sif

%labels
    org.opencontainers.image.title psrenterprise
    org.opencontainers.image.source https://github.com/golamshaifullah/psrall_containers
    org.opencontainers.image.description "Enterprise/PTA Python stack on psrbase"

%environment
    export INSTALL_DIR=/usr/local
    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export PATH=/opt/mamba/bin:/usr/local/tempo2/bin:/usr/local/bin:$PATH

    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_DEV=/xs
    export PGPLOT_TYPE=pgplot
    export PGPLOT_INCLUDES=/usr/include
    export PGPLOT_LIB=/usr/lib

    export TEMPO2=/usr/local/tempo2
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

%post
    set -eux
    unset MAKEFLAGS MFLAGS MAKELEVEL GNUMAKEFLAGS MAKEOVERRIDES
    export MAKE=make

    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export PATH=/opt/mamba/bin:/usr/local/tempo2/bin:/usr/local/bin:${PATH}

    micromamba install -y -n base \
        -c conda-forge \
        --strict-channel-priority \
        python=3.11 \
        pip \
        numpy \
        scipy \
        matplotlib \
        pandas \
        astropy \
        astroquery \
        astroplan \
        ephem \
        h5py \
        fitsio \
        healpy \
        corner \
        arviz \
        bilby \
        libstempo \
        pint-pulsar \
        psrqpy \
        ptmcmcsampler \
        enterprise-pulsar \
        enterprise_extensions \
        la_forge \
        pypulse \
        dask \
        numba \
        numexpr \
        scikit-learn \
        statsmodels \
        ipython \
        notebook \
        jupyterlab \
        lmfit \
        aplpy \
        line_profiler \
        peakutils \
        bitstring

    micromamba clean --all --yes
