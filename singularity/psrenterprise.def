BootStrap: localimage
From: psrbase.sif


%environment
    export PATH=/usr/local/bin:$PATH
    export CPATH=/usr/local/include:$CPATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export LIBRARY_PATH=/usr/local/lib:$LIBRARY_PATH
    export TEMPO2=/usr/local/tempo2
    export TEMPO2_CLOCK_DIR=/usr/local/tempo2/T2runtime
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins
    export PSRCHIVE_PATH=/usr/local/psrchive
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=/usr/local/include
    export PGPLOT_LIB=/usr/local/lib
    export GIZA_LIBS="-lgiza"
    export PGPLOT_TYPE=giza
    export CERT_SOURCE='/etc/ssl/certs/ca-certificates.crt'
    export MAMBA_USER=mambauser
    export MAMBA_USER_ID=57439
    export MAMBA_USER_GID=57439
    export MAMBA_USER=$MAMBA_USER
    export MAMBA_USER_ID=$MAMBA_USER_ID
    export MAMBA_USER_GID=$MAMBA_USER_GID
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
    export ENV_NAME="base"
    export MAMBA_ROOT_PREFIX="/opt/mamba"
    export MAMBA_EXE="/bin/micromamba"
    export PATH=$MAMBA_ROOT_PREFIX/bin:$PATH


%post
    export PATH=/usr/local/bin:$PATH
    export CPATH=/usr/local/include:$CPATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export LIBRARY_PATH=/usr/local/lib:$LIBRARY_PATH
    export TEMPO2=/usr/local/tempo2
    export TEMPO2_CLOCK_DIR=/usr/local/tempo2/T2runtime
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins
    export PSRCHIVE_PATH=/usr/local/psrchive
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH
    export MAMBA_ROOT_PREFIX=/usr/local/micromamba
    export PATH=$MAMBA_ROOT_PREFIX/bin:$PATH
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=/usr/local/include
    export PGPLOT_LIB=/usr/local/lib
    export GIZA_LIBS="-lgiza"
    export PGPLOT_TYPE=giza
    export CERT_SOURCE='/etc/ssl/certs/ca-certificates.crt'
    export MAMBA_USER=mambauser
    export MAMBA_USER_ID=57439
    export MAMBA_USER_GID=57439
    export MAMBA_USER=$MAMBA_USER
    export MAMBA_USER_ID=$MAMBA_USER_ID
    export MAMBA_USER_GID=$MAMBA_USER_GID
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
    export ENV_NAME="base"
    export MAMBA_ROOT_PREFIX="/opt/mamba"
    export MAMBA_EXE="/opt/mamba/bin/micromamba"
    export PATH=$MAMBA_ROOT_PREFIX/bin:$PATH
    
    # Install Micromamba
    micromamba install -y -n base -c conda-forge \
        python=3.11 bokeh bottleneck corner cycler cython dask docutils acor>=1.1.1 astropy astroquery ephem \
	libblas[build=*mkl] libstempo marshmallow matplotlib mpfr mpi4py nose notebook numba numexpr numpy pandas patsy \
	fitsio gitpython gmp h5py healpy imagecodecs imageio ipympl ipython jplephem jupyter jupyter_contrib_nbextensions \
	pyregion pytables pytest pytest-xdist  pytz pywavelets pyyaml ruamel.yaml scikit-image scikit-learn scikit-sparse scipy \
	seaborn seaborn-base setuptools six statsmodels suitesparse tifffile vincent wand yt  \
	bilby enterprise-pulsar enterprise_extensions enterprise_outliers la_forge \
	pint-pal>=0.1.0 pint-pulsar>=0.9 psrqpy ptmcmcsampler pyerfa pymultinest>=2.11 pypulse>=0.1.1
  
    pip3 install --no-cache-dir \
        h5py paramz astroplan peakutils datetime bitstring astropy_helpers pyephem APLpy astroquery lmfit healpy corner line_profiler jplephem
        
    #jupyter contrib nbextension install --user
    micromamba clean --all -y

    pip install git+https://github.com/nanograv/PINT@master
    pip install git+https://github.com/vallis/libstempo@master
    pip install git+https://github.com/nanograv/enterprise@dev
    pip install git+https://github.com/nanograv/enterprise_extensions@dcbusyweek
    pip install git+https://github.com/nanograv/pint_pal@main
    pip install git+https://github.com/nanograv/enterprise@dev
    pip install git+https://github.com/nanograv/enterprise_extensions@dcbusyweek
    pip install git+https://github.com/bvgoncharov/enterprise_warp
    pip install git+https://github.com/nanograv/fastshermanmorrison.git
    pip install git+https://github.com/NihanPol/MAPS.git@main

    apt-get clean
    apt-get -y autoremove

    ## in lieu of real tests; and to plug in the 'latest' astropy cache at build time
    python -c "from astropy.time import Time; t=Time.now(); t.ut1; from astropy.utils.data import get_pkg_data_contents; get_pkg_data_contents(\"coordinates/sites-un-ascii\"); from astropy.utils.iers import IERS_B_URL, IERS_B; from astropy.utils.data import download_file; IERS_B.open(download_file(IERS_B_URL, cache=True))[\"year\",\"month\",\"day\"][-3:]; from astropy.utils import iers; iers.conf.auto_max_age = None"
    python -c "from enterprise.pulsar import Pulsar"
    ls $(python -c "from astropy.config import get_config_dir; print(get_config_dir())")
   