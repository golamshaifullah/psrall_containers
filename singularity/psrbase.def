Bootstrap: docker
From: mambaorg/micromamba:2.6.1

%labels
    org.opencontainers.image.source https://github.com/golamshaifullah/psrall_containers
    org.opencontainers.image.description psrbase with real PGPLOT, CFITSIO 4.6.4, HDF5, and Tempo2

%environment
    export INSTALL_DIR=/usr/local

    export PATH=/usr/local/bin:/opt/mamba/bin:$PATH
    export CPATH=/usr/local/include:/usr/local/pgplot:$CPATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/pgplot:/usr/local/hdf5/lib:/opt/mamba/lib:$LD_LIBRARY_PATH
    export LIBRARY_PATH=/usr/local/lib:/usr/local/pgplot:/usr/local/hdf5/lib:$LIBRARY_PATH
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/hdf5/lib/pkgconfig:$PKG_CONFIG_PATH

    export TEMPO2=/usr/local/tempo2
    export TEMPO2_CLOCK_DIR=/usr/local/tempo2/T2runtime
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins

    export PSRCHIVE_PATH=/usr/local/psrchive
    export PSRCHIVE_CONFIG=/usr/local/etc/psrchive.cfg

    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=/usr/local/pgplot
    export PGPLOT_LIB=/usr/local/pgplot
    export PGPLOT_TYPE=pgplot

    export CERT_SOURCE=/etc/ssl/certs/ca-certificates.crt
    export MAMBA_USER=mambauser
    export MAMBA_USER_ID=57439
    export MAMBA_USER_GID=57439
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export ENV_NAME=base
    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba


%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    export CFITSIO_VERSION=4.6.4
    export HDF5_VERSION=1.14.6

    export INSTALL_DIR=/usr/local

    export PATH=/usr/local/bin:/opt/mamba/bin:$PATH
    export CPATH=/usr/local/include:/usr/local/pgplot:${CPATH:-}
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/pgplot:/usr/local/hdf5/lib:/opt/mamba/lib:${LD_LIBRARY_PATH:-}
    export LIBRARY_PATH=/usr/local/lib:/usr/local/pgplot:/usr/local/hdf5/lib:${LIBRARY_PATH:-}
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/hdf5/lib/pkgconfig:${PKG_CONFIG_PATH:-}

    export TEMPO2=/usr/local/tempo2
    export TEMPO2_CLOCK_DIR=${TEMPO2}/T2runtime
    export TEMPO2_PATH=${TEMPO2}/T2runtime
    export TEMPO2_PLUGIN_PATH=${TEMPO2}/T2runtime/plugins

    export PSRCHIVE_PATH=/usr/local/psrchive
    export PSRCHIVE_CONFIG=/usr/local/etc/psrchive.cfg

    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=${PGPLOT_DIR}/grfont.dat
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=${PGPLOT_DIR}
    export PGPLOT_LIB=${PGPLOT_DIR}
    export PGPLOT_TYPE=pgplot

    export CERT_SOURCE=/etc/ssl/certs/ca-certificates.crt
    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export ENV_NAME=base
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8


    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        build-essential \
        gcc \
        g++ \
        gfortran \
        make \
        cmake \
        automake \
        autoconf \
        libtool \
        autoconf-archive \
        pkg-config \
        perl \
        m4 \
        zlib1g-dev \
        libbz2-dev \
        libssl-dev \
        libfftw3-dev \
        libgsl-dev \
        libltdl-dev \
        libpng-dev \
        libcairo2-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libsqlite3-dev \
        libncurses-dev \
        libreadline-dev \
        libglib2.0-dev \
        libeigen3-dev \
        tcl-dev \
        tk-dev \
        libx11-dev \
        libxext-dev \
        libxt-dev \
        x11-utils \
        python3 \
        python3-pip \
        python3-dev \
        libopenblas-dev \
        liblapack-dev
    rm -rf /var/lib/apt/lists/*

    # -------------------------------------------------------------------------
    # PGPLOT
    #
    # Use distro-packaged PGPLOT instead of compiling the old upstream source.
    # Debian packages include:
    #   /usr/lib/libpgplot.*
    #   /usr/lib/libcpgplot.*
    #   /usr/include/cpgplot.h
    #   /usr/lib/pgplot5/grfont.dat
    #   /usr/bin/pgxwin_server
    # -------------------------------------------------------------------------

    . /etc/os-release

    if [ -f /etc/apt/sources.list.d/debian.sources ]; then
        sed -i -E 's/Components: main$/Components: main contrib non-free non-free-firmware/' \
            /etc/apt/sources.list.d/debian.sources
    elif [ -f /etc/apt/sources.list ]; then
        sed -i -E 's/ main$/ main contrib non-free non-free-firmware/g' \
            /etc/apt/sources.list
    fi

    apt-get update
    apt-get install -y --no-install-recommends \
        pgplot5 \
        gfortran \
        libx11-dev \
        libxt-dev \
        libpng-dev \
        zlib1g-dev

    ln -sf /usr/lib/libpgplot.so /usr/local/lib/libpgplot.so
    ln -sf /usr/lib/libpgplot.a /usr/local/lib/libpgplot.a
    ln -sf /usr/lib/libcpgplot.so /usr/local/lib/libcpgplot.so
    ln -sf /usr/lib/libcpgplot.a /usr/local/lib/libcpgplot.a
    ln -sf /usr/include/cpgplot.h /usr/local/include/cpgplot.h

    mkdir -p /usr/local/pgplot
    ln -sf /usr/lib/pgplot5/grfont.dat /usr/local/pgplot/grfont.dat
    ln -sf /usr/lib/pgplot5/rgb.txt /usr/local/pgplot/rgb.txt
    ln -sf /usr/bin/pgxwin_server /usr/local/pgplot/pgxwin_server

    echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf
    echo "/usr/lib" > /etc/ld.so.conf.d/pgplot.conf
    ldconfig

    # ----------------------------------------------------------------------
    # HDF5
    # ----------------------------------------------------------------------
    cd /tmp
    curl -fL --retry 3 -o hdf5-${HDF5_VERSION}.tar.gz \
        https://support.hdfgroup.org/releases/hdf5/v1_14/v1_14_6/downloads/hdf5-${HDF5_VERSION}.tar.gz
    tar -xzf hdf5-${HDF5_VERSION}.tar.gz
    cd hdf5-${HDF5_VERSION}
    ./configure \
        --prefix=/usr/local/hdf5 \
        --enable-cxx \
        --enable-fortran \
        --enable-profiling=yes
    make -j$(nproc)
    make install
    rm -rf /tmp/hdf5-${HDF5_VERSION} /tmp/hdf5-${HDF5_VERSION}.tar.gz

    # ----------------------------------------------------------------------
    # CFITSIO
    # ----------------------------------------------------------------------
    cd /tmp
    curl -fL --retry 3 -o cfitsio-${CFITSIO_VERSION}.tar.gz \
        https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-${CFITSIO_VERSION}.tar.gz
    tar -xzf cfitsio-${CFITSIO_VERSION}.tar.gz
    cd cfitsio-${CFITSIO_VERSION}
    ./configure \
        --prefix=/usr/local \
        --enable-reentrant \
        --enable-sse2
    make -j$(nproc)
    make install
    ldconfig
    rm -rf /tmp/cfitsio-${CFITSIO_VERSION} /tmp/cfitsio-${CFITSIO_VERSION}.tar.gz

    # ----------------------------------------------------------------------
    # Tempo2
    # ----------------------------------------------------------------------
    cd /tmp
    rm -rf /tmp/tempo2
    git clone --depth 1 https://bitbucket.org/psrsoft/tempo2.git
    cd tempo2

    export F77=gfortran
    export FC=gfortran
    export CFLAGS="-I${PGPLOT_DIR} -I/usr/local/include -fPIC ${CFLAGS:-}"
    export CXXFLAGS="-I${PGPLOT_DIR} -I/usr/local/include -fPIC ${CXXFLAGS:-}"
    export FFLAGS="-fPIC -fallow-argument-mismatch ${FFLAGS:-}"
    export LDFLAGS="-L${PGPLOT_DIR} -L/usr/local/lib -Wl,-rpath,${PGPLOT_DIR} -Wl,-rpath,/usr/local/lib ${LDFLAGS:-}"

    ./bootstrap
    ./configure \
        --prefix=${TEMPO2} \
        --with-pgplot=/usr \
        --with-tempo2-plug-dir=${TEMPO2}/plugins \
        --with-fftw3-dir=/usr \
        --enable-static \
        --enable-shared \
        --with-pic \
        --x-includes=/usr/include \
        --x-libraries=/usr/lib/x86_64-linux-gnu \
        F77=gfortran \
        FC=gfortran

    make -j$(nproc)
    make install
    make plugins-install

    mkdir -p ${TEMPO2}/T2runtime
    cp -r T2runtime/* ${TEMPO2}/T2runtime/
    rm -rf /tmp/tempo2

    ldconfig

%test
    test -f /usr/local/pgplot/libpgplot.a
    test -f /usr/local/pgplot/libcpgplot.a
    test -f /usr/local/pgplot/grfont.dat
    test -e /usr/local/lib/libcfitsio.a -o -e /usr/local/lib/libcfitsio.so
    test -d /usr/local/tempo2/T2runtime

%help
    Base pulsar-analysis image with real PGPLOT, CFITSIO 4.6.4, HDF5, and Tempo2.
