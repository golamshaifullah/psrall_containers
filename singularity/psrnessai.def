Bootstrap: localimage
From: psrenterprise.sif

%labels
    org.opencontainers.image.title psrnessai
    org.opencontainers.image.source https://github.com/golamshaifullah/psrall_containers
    org.opencontainers.image.description "nessai CPU image on psrenterprise"

%environment
    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export PATH=/opt/mamba/bin:/usr/local/tempo2/bin:/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

%post
    set -eux

    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export PATH=/opt/mamba/bin:/usr/local/tempo2/bin:/usr/local/bin:${PATH}

    # Keep the default CI image CPU-only. CUDA variants should be separate defs.
    micromamba install -y -n base \
        -c conda-forge \
        --strict-channel-priority \
        nessai \
        pytorch \
        torchvision \
        torchaudio

    micromamba clean --all --yes

%test
    set -eu
    python - <<'PY'
import nessai
import torch
print('psrnessai imports ok; cuda_available=', torch.cuda.is_available())
PY
