Bootstrap: docker
From: mambaorg/micromamba:2.6.1

%labels
    org.opencontainers.image.title psrbase
    org.opencontainers.image.source https://github.com/golamshaifullah/psrall_containers
    org.opencontainers.image.description "Base pulsar image with packaged PGPLOT/HDF5, current CFITSIO, and Tempo2"

%environment
    export INSTALL_DIR=/usr/local

    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_DEV=/xs
    export PGPLOT_BACKGROUND=white
    export PGPLOT_FOREGROUND=black
    export PGPLOT_INCLUDES=/usr/include
    export PGPLOT_LIB=/usr/lib
    export PGPLOT_TYPE=pgplot

    export HDF5_DIR=/usr
    export HDF5_INCLUDE_DIR=/usr/include/hdf5/serial
    export HDF5_LIB_DIR=/usr/lib/x86_64-linux-gnu/hdf5/serial
    export HDF5_CFLAGS="-I/usr/include/hdf5/serial"
    export HDF5_LIBS="-L/usr/lib/x86_64-linux-gnu/hdf5/serial -lhdf5 -lhdf5_hl"

    export TEMPO2=/usr/local/tempo2
    export TEMPO2_CLOCK_DIR=/usr/local/tempo2/T2runtime
    export TEMPO2_PATH=/usr/local/tempo2/T2runtime
    export TEMPO2_PLUGIN_PATH=/usr/local/tempo2/T2runtime/plugins

    export PSRCHIVE_PATH=/usr/local
    export CERT_SOURCE=/etc/ssl/certs/ca-certificates.crt

    export MAMBA_ROOT_PREFIX=/opt/mamba
    export MAMBA_EXE=/bin/micromamba
    export PATH=/usr/local/tempo2/bin:/usr/local/bin:/opt/mamba/bin:$PATH
    export CPATH=/usr/local/include:/usr/include:/usr/include/hdf5/serial:$CPATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:$LD_LIBRARY_PATH
    export LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:$LIBRARY_PATH
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:$PKG_CONFIG_PATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    export INSTALL_DIR=/usr/local
    export CFITSIO_VERSION=4.6.4
    export TEMPO2=/usr/local/tempo2
    export PGPLOT_DIR=/usr/local/pgplot
    export PGPLOT_FONT=/usr/local/pgplot/grfont.dat
    export PGPLOT_INCLUDES=/usr/include
    export PGPLOT_LIB=/usr/lib
    export HDF5_INCLUDE_DIR=/usr/include/hdf5/serial
    export HDF5_LIB_DIR=/usr/lib/x86_64-linux-gnu/hdf5/serial
    export PATH=/usr/local/tempo2/bin:/usr/local/bin:/opt/mamba/bin:${PATH}
    export CPATH=/usr/local/include:/usr/include:/usr/include/hdf5/serial:${CPATH:-}
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:${LD_LIBRARY_PATH:-}
    export LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/hdf5/serial:${LIBRARY_PATH:-}
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH:-}
    export NP=${NP:-$(nproc)}

    # PGPLOT is non-free in Debian, so enable the non-free component.
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then
        sed -i -E 's/^Components: .*/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources
    fi
    if [ -f /etc/apt/sources.list ]; then
        sed -i -E 's/ main( |$)/ main contrib non-free non-free-firmware\1/g' /etc/apt/sources.list
    fi

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        build-essential \
        gfortran \
        gcc \
        g++ \
        make \
        cmake \
        automake \
        autoconf \
        libtool \
        autoconf-archive \
        pkg-config \
        perl \
        zlib1g-dev \
        libbz2-dev \
        libssl-dev \
        libfftw3-dev \
        libgsl-dev \
        libltdl-dev \
        libpng-dev \
        libcairo2-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libsqlite3-dev \
        libncurses-dev \
        libreadline-dev \
        libglib2.0-dev \
        libeigen3-dev \
        libxml2-dev \
        tcl-dev \
        tk-dev \
        libx11-dev \
        libxext-dev \
        libxt-dev \
        x11-utils \
        python3 \
        python3-dev \
        python3-pip \
        python3-numpy \
        libopenblas-dev \
        liblapack-dev \
        libhdf5-dev \
        hdf5-tools \
        pgplot5

    # Normalize packaged PGPLOT into the paths expected by legacy pulsar tools.
    mkdir -p /usr/local/pgplot /usr/local/lib /usr/local/include
    if [ -e /usr/lib/libpgplot.so ]; then ln -sf /usr/lib/libpgplot.so /usr/local/lib/libpgplot.so; fi
    if [ -e /usr/lib/libpgplot.a ]; then ln -sf /usr/lib/libpgplot.a /usr/local/lib/libpgplot.a; fi
    if [ -e /usr/lib/libcpgplot.so ]; then ln -sf /usr/lib/libcpgplot.so /usr/local/lib/libcpgplot.so; fi
    if [ -e /usr/lib/libcpgplot.a ]; then ln -sf /usr/lib/libcpgplot.a /usr/local/lib/libcpgplot.a; fi
    ln -sf /usr/include/cpgplot.h /usr/local/include/cpgplot.h
    ln -sf /usr/lib/pgplot5/grfont.dat /usr/local/pgplot/grfont.dat
    if [ -e /usr/lib/pgplot5/rgb.txt ]; then ln -sf /usr/lib/pgplot5/rgb.txt /usr/local/pgplot/rgb.txt; fi
    if [ -x /usr/bin/pgxwin_server ]; then ln -sf /usr/bin/pgxwin_server /usr/local/pgplot/pgxwin_server; fi

    # Normalize Debian's serial HDF5 layout for older configure scripts.
    ln -sf /usr/include/hdf5/serial/hdf5.h /usr/local/include/hdf5.h
    ln -sf /usr/lib/x86_64-linux-gnu/hdf5/serial/libhdf5.so /usr/local/lib/libhdf5.so
    ln -sf /usr/lib/x86_64-linux-gnu/hdf5/serial/libhdf5_hl.so /usr/local/lib/libhdf5_hl.so

    echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf
    echo "/usr/lib" > /etc/ld.so.conf.d/pgplot.conf
    echo "/usr/lib/x86_64-linux-gnu/hdf5/serial" > /etc/ld.so.conf.d/hdf5-serial.conf
    ldconfig

    mkdir -p ${INSTALL_DIR}/src

    # CFITSIO is kept as a small source build so this image gets the current
    # upstream version rather than the older distro package.
    cd /tmp
    curl -fL --retry 3 -o cfitsio-${CFITSIO_VERSION}.tar.gz \
        https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-${CFITSIO_VERSION}.tar.gz
    tar -xzf cfitsio-${CFITSIO_VERSION}.tar.gz
    cd cfitsio-${CFITSIO_VERSION}
    ./configure \
        --prefix=/usr/local \
        --enable-reentrant \
        --enable-sse2
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make -j${NP}
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make install
    ldconfig
    rm -rf /tmp/cfitsio-${CFITSIO_VERSION} /tmp/cfitsio-${CFITSIO_VERSION}.tar.gz

    # Tempo2 is source-built. PGPLOT, FFTW, HDF5, GSL and X11 are packaged.
    cd /tmp
    rm -rf /tmp/tempo2
    git clone --depth=1 https://bitbucket.org/psrsoft/tempo2.git
    cd tempo2

    export F77=gfortran
    export FC=gfortran
    export CPPFLAGS="-I/usr/local/include -I/usr/include -I/usr/include/hdf5/serial ${CPPFLAGS:-}"
    export CFLAGS="${CPPFLAGS} ${CFLAGS:-}"
    export CXXFLAGS="${CPPFLAGS} ${CXXFLAGS:-}"
    export LDFLAGS="-L/usr/local/lib -L/usr/lib -L/usr/lib/x86_64-linux-gnu -L/usr/lib/x86_64-linux-gnu/hdf5/serial -Wl,-rpath,/usr/local/lib -Wl,-rpath,/usr/lib/x86_64-linux-gnu/hdf5/serial ${LDFLAGS:-}"

    ./bootstrap
    ./configure \
        --prefix=${TEMPO2} \
        --with-pgplot=/usr \
        --with-tempo2-plug-dir=${TEMPO2}/plugins \
        --with-fftw3-dir=/usr \
        --enable-static \
        --enable-shared \
        --with-pic \
        --x-includes=/usr/include \
        --x-libraries=/usr/lib/x86_64-linux-gnu \
        F77=gfortran \
        FC=gfortran
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make -j${NP}
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make install
    env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make plugins-install || true
    mkdir -p ${TEMPO2}/T2runtime
    if [ -d T2runtime ]; then cp -a T2runtime/. ${TEMPO2}/T2runtime/; fi
    rm -rf /tmp/tempo2

    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

%test
    set -eu
    test -f /usr/local/pgplot/grfont.dat
    test -f /usr/local/include/cpgplot.h
    test -e /usr/local/lib/libcfitsio.so -o -e /usr/local/lib/libcfitsio.a
    test -f /usr/include/hdf5/serial/hdf5.h
    h5dump --version >/dev/null
    test -d /usr/local/tempo2/T2runtime
    test -x /usr/local/tempo2/bin/tempo2
